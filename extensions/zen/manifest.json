{
  "manifest_version": 3,
  "name": "Job Tracker Quick Add",
  "version": "1.0.0",
  "description": "Quickly log an application in the local Job Tracker.",
  "icons": {
    "32": "icon.svg",
    "64": "icon.svg"
  },
  "action": {
    "default_title": "Quick add application",
    "default_popup": "popup.html",
    "default_icon": "icon.svg"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+J",
        "mac": "Command+Shift+J"
      },
      "description": "Open the quick-add form"
    }
  },
  "permissions": [
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:9000/*",
    "http://localhost:9000/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "job-tracker-quick-add@local",
      "strict_min_version": "127.0"
    }
  }
}
